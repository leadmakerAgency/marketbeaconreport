# Required
BREVO_API_KEY=            # Brevo > SMTP & API > API keys. Create a fresh key; don't reuse one pasted anywhere.
SITE_SECRET=              # 32+ random characters. Signs the manage/unsubscribe links. Never change it after launch.
CRON_SECRET=              # Random string. Vercel sends it to /api/cron automatically.
BREVO_WEBHOOK_SECRET=     # Random string. Goes on the end of the Brevo webhook URL as ?key=
NEXT_PUBLIC_SITE_URL=https://marketbeaconreport.com

# Optional
CONTACT_EMAIL=editor@marketbeaconreport.com
SENDER_POSTAL_ADDRESS=100 Mount St, North Sydney NSW 2060, Australia
PUBLISHER_NAME=           # Legal name of the publisher, shown on /impressum
SEND_GOODBYE_EMAIL=true   # false to skip the "sorry to see you go" email
